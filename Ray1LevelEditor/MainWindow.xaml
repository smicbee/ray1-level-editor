<Window x:Class="Ray1LevelEditor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rayman 1 Level Editor" Width="1400" Height="860" Background="#FF2B2B2B" Foreground="White">
  <DockPanel>
    <ToolBarTray DockPanel.Dock="Top"><ToolBar>
      <ComboBox x:Name="cbWorld" Width="130"/><ComboBox x:Name="cbLevel" Width="60"/>
      <Button Content="Open" Click="OnOpen"/><Button Content="Save (Ctrl+S)" Click="OnSave"/><Separator/>
      <Button Content="Undo" Click="OnUndo"/><Button Content="Redo" Click="OnRedo"/><Separator/>
      <RadioButton x:Name="rSel" Content="Select/Objects" GroupName="t" IsChecked="True" Margin="4,0"/>
      <RadioButton x:Name="rTile" Content="Paint tile" GroupName="t" Margin="4,0"/>
      <RadioButton x:Name="rColl" Content="Paint collision" GroupName="t" Margin="4,0"/>
      <RadioButton x:Name="rPick" Content="Eyedropper" GroupName="t" Margin="4,0"/><Separator/>
      <CheckBox x:Name="chColl" Content="Collision" Margin="4,0" Checked="OnView" Unchecked="OnView"/>
      <CheckBox x:Name="chObj" Content="Objects" IsChecked="True" Margin="4,0" Checked="OnView" Unchecked="OnView"/>
      <Button Content="Test in game" Click="OnTest"/>
    </ToolBar>
    <ToolBar Band="1" BandIndex="0">
      <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="2,0"/>
      <Button Content=" − " Click="OnZoomOut" ToolTip="Zoom out (Ctrl+-)"/>
      <Slider x:Name="slZoom" Width="130" Minimum="25" Maximum="800" Value="100" IsMoveToPointEnabled="True" ValueChanged="OnZoomSlider" VerticalAlignment="Center" ToolTip="25% – 800%"/>
      <Button Content=" + " Click="OnZoomIn" ToolTip="Zoom in (Ctrl++)"/>
      <TextBlock x:Name="tbZoom" Text="100%" Width="42" VerticalAlignment="Center" Margin="4,0" TextAlignment="Right"/>
      <Button Content="100%" Click="OnZoom100" ToolTip="Ctrl+0"/><Button Content="Fit" Click="OnZoomFit" ToolTip="Ctrl+9"/>
      <Separator/>
      <CheckBox x:Name="chBg" Content="Background" IsChecked="True" Margin="4,0" Checked="OnBgToggle" Unchecked="OnBgToggle"/>
      <CheckBox x:Name="chBg2" Content="Parallax layer" IsChecked="True" Margin="4,0" Checked="OnBgToggle" Unchecked="OnBgToggle" ToolTip="Second image (ScrollDiffFondIndex), index 0 = transparent"/>
      <ComboBox x:Name="cbBgMode" Width="170" SelectedIndex="0" SelectionChanged="OnBgMode">
        <ComboBoxItem Content="Anchor: level (tiled)"/><ComboBoxItem Content="Anchor: camera (fixed)"/><ComboBoxItem Content="Anchor: camera, parallax 25%"/>
      </ComboBox>
      <Separator/>
      <CheckBox x:Name="chPath" Content="Script path" IsChecked="True" Margin="4,0" Checked="OnPvOpt" Unchecked="OnPvOpt"/>
    </ToolBar></ToolBarTray>
    <StatusBar DockPanel.Dock="Bottom"><TextBlock x:Name="status"/></StatusBar>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Collision type (for painting):" Margin="4"/>
        <ComboBox DockPanel.Dock="Top" x:Name="cbType" Margin="4"/>
        <TextBlock DockPanel.Dock="Top" x:Name="tbTile" Text="Tile: 0" Margin="4"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><Image x:Name="imgTiles" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" MouseLeftButtonDown="OnTilePick" RenderOptions.BitmapScalingMode="NearestNeighbor"/></ScrollViewer>
      </DockPanel>
      <Grid Grid.Column="1" Background="#FF101010" ClipToBounds="True">
      <Rectangle x:Name="bgCam" Visibility="Collapsed" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
      <ScrollViewer x:Name="sv" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Transparent" ScrollChanged="OnSvScroll">
        <Grid x:Name="host" HorizontalAlignment="Left" VerticalAlignment="Top">
          <Rectangle x:Name="bgLvl" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
          <Image x:Name="imgMap" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Left" VerticalAlignment="Top"/>
          <Canvas x:Name="overlay" IsHitTestVisible="False"/>
          <Canvas x:Name="pv" IsHitTestVisible="False"/>
          <Canvas x:Name="pvAnim" IsHitTestVisible="False"/>
        </Grid>
      </ScrollViewer></Grid>
      <TabControl Grid.Column="2" Background="#FF2B2B2B">
        <TabItem Header="Object"><DockPanel Background="#FF2B2B2B">
          <WrapPanel DockPanel.Dock="Top">
            <Button Content="Duplicate" Click="OnDup" Margin="2"/><Button Content="Delete (Del)" Click="OnDel" Margin="2"/>
            <ComboBox x:Name="cbTpl" Width="170" Margin="2" ToolTip="New object from template (types in this level)"/><Button Content="New" Click="OnNew" Margin="2"/>
          </WrapPanel>
          <TextBlock DockPanel.Dock="Top" x:Name="tbSel" Margin="4" Foreground="White" TextWrapping="Wrap"/>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" Background="#FF1E2A33">
            <TextBlock TextWrapping="Wrap" Foreground="#FFFFD080" FontSize="11" Margin="3" Text="Preview is an APPROXIMATION: movement/states are derived from the script and ETA speeds; the real behavior is partly hard-coded in the game per object type (collision, enemy AI, tests)."/>
            <WrapPanel>
              <Button x:Name="btPlay" Content="▶ Play" Width="62" Margin="2" Click="OnPvPlay"/><Button Content="⏭ Step" Margin="2" Click="OnPvStep"/><Button Content="⏮ Reset" Margin="2" Click="OnPvReset"/>
              <TextBlock Text="Speed" VerticalAlignment="Center" Margin="4,0,2,0"/>
              <ComboBox x:Name="cbPvSpeed" Width="58" Margin="2" SelectedIndex="2"><ComboBoxItem Content="0.25×"/><ComboBoxItem Content="0.5×"/><ComboBoxItem Content="1×"/><ComboBoxItem Content="2×"/><ComboBoxItem Content="4×"/></ComboBox>
              <TextBlock Text="TEST =" VerticalAlignment="Center" Margin="4,0,2,0"/>
              <ComboBox x:Name="cbTest" Width="62" Margin="2" SelectedIndex="0" SelectionChanged="OnPvOpt"><ComboBoxItem Content="false"/><ComboBoxItem Content="true"/></ComboBox>
            </WrapPanel>
            <TextBlock x:Name="tbPv" Foreground="White" Margin="3" TextWrapping="Wrap" FontSize="11"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" x:Name="tbErr" Foreground="#FFFF6060" TextWrapping="Wrap" Margin="3"/>
          <Grid DockPanel.Dock="Bottom" Height="190"><TextBox x:Name="tbCmds" AcceptsReturn="True" FontFamily="Consolas" LostFocus="OnCmds" VerticalScrollBarVisibility="Auto" TextChanged="OnCmdsChanged"/><Canvas x:Name="hlCanvas" IsHitTestVisible="False" ClipToBounds="True"><Rectangle x:Name="hlRect" Fill="#66FF9000" Stroke="#FFFF9000" Visibility="Collapsed"/></Canvas></Grid>
          <TextBlock DockPanel.Dock="Bottom" Text="Commands (one per line: NAME arg; jumps use label numbers, offsets are recomputed when applied):" TextWrapping="Wrap" Foreground="White" Margin="4,4,4,0"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FF2B2B2B"><StackPanel x:Name="props" Background="#FF2B2B2B"/></ScrollViewer>
        </DockPanel></TabItem>
        <TabItem Header="Level"><StackPanel Margin="6" x:Name="lvlPanel" Background="#FF2B2B2B"/></TabItem>
        <TabItem Header="Palette"><DockPanel Background="#FF2B2B2B">
          <WrapPanel DockPanel.Dock="Top"><ComboBox x:Name="cbPal" Width="60" SelectionChanged="OnPalSel"/>
            <TextBlock Text=" Index:" VerticalAlignment="Center"/><TextBlock x:Name="tbPalIdx" Text="0" Width="30" VerticalAlignment="Center"/>
            <TextBlock Text="R"/><TextBox x:Name="pR" Width="35" LostFocus="OnPalEdit"/><TextBlock Text="G"/><TextBox x:Name="pG" Width="35" LostFocus="OnPalEdit"/><TextBlock Text="B"/><TextBox x:Name="pB" Width="35" LostFocus="OnPalEdit"/>
            <TextBlock Text=" (0..63)"/></WrapPanel>
          <Image x:Name="imgPal" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" MouseLeftButtonDown="OnPalPick" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </DockPanel></TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
